PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=

ZHIHU_ACCESS_SECRET=
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=

# 公网试用：站点 API Key 只配置在服务端。支持 qwen / deepseek / kimi / openai。
AI_TRIAL_PROVIDER=deepseek
AI_TRIAL_MODEL=deepseek-v4-flash
AI_TRIAL_API_KEY=
AI_TRIAL_TOKEN_LIMIT=20000
AI_MAX_OUTPUT_TOKENS=2000

# 缺少持久化额度存储时站点试用关闭，自带 Key 仍可使用。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
